-- Cabal project file for building pandoc
-- Used by both fetch-pandoc.sh and Containerfile.pandoc

packages: .

repository local-hackage
  url: file+noindex:///opt/hackage/packages

-- Disable tests to avoid test-only dependency conflicts
tests: False
benchmarks: False

-- Build settings
package *
  optimization: 2
  library-stripping: True
  executable-stripping: True
  ghc-options: -j -split-sections -optc-Os -optl=-pthread

-- Embed data files in the pandoc binary, disable HTTP support
package pandoc
  flags: +embed_data_files -http -export-dynamic

-- Enable lua scripting and built-in server
package pandoc-cli
  flags: +lua +server -export-dynamic

-- Relax all version bounds to get past dependency resolution with GHC 9.6.
-- TODO: tighten once a successful build is confirmed.
allow-newer: all
